FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ make \
    sumo \
    libglib2.0-0 \
    libx11-6 libxext6 libxrender1 libxrandr2 libxi6 libxtst6 \
    libxfixes3 libxcomposite1 libxdamage1 libxcursor1 \
    libxkbcommon-x11-0 libxcb-xinerama0 \
    libsm6 libice6 libdbus-1-3 \
    libgl1 libegl1 \
    libfontconfig1 libfreetype6 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml poetry.lock README.md /app/
RUN pip install --no-cache-dir poetry poetry-plugin-export \
    && poetry export -o /app/requirements.txt --without-hashes
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY crdesigner /app/crdesigner
ENV PYTHONPATH=/app
ENTRYPOINT ["python","-m","crdesigner.ui.command_line"]
